  "cards": [
    {
      "dot": "emerald",
      "title": "四层各自管什么",
      "items": [
        "A 定边界与规则：负债、监管、限额先变成结构化输入，不放到最后检查",
        "B 出观点与证据：宏观 / 信用 / 权益 / 另类并行研究，再交叉质询收敛",
        "C 在约束下求解：久期缺口、压力测试、目标权重与偏离理由",
        "D 闸门与留痕：合规校验、例外升级、人签批、审计可复现"
      ]
    },
    {
      "dot": "amber",
      "title": "Agent 到底拆几个",
      "items": [
        "四条全中才拆：独立数据 / 独立方法 / 独立输出 / 独立责任人",
        "起步 2-3 个 → 标准 5-7 个 → 完整 8-10 个，不一步到位",
        "口径不一致比观点不新颖更致命，宁可合并不要分叉"
      ]
    },
    {
      "dot": "rose",
      "title": "人的两处不可替代",
      "items": [
        "签批：投资经理与投委会承担决策责任，Agent 只出建议",
        "下单与交收：Agent 不接触交易接口，成交与估值回写 A1",
        "每个观点必须带失效条件：数字由代码算，语言由模型组织"
      ]
    }
